    "@types/jasmine": "~5.1.0",
    "@types/pdfmake": "0.3.3",
    "angular-eslint": "20.7.0",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
