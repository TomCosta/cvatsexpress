  "version": "0.2.0",
  "description": "Aplicativo Android offline-first para criação de currículos ATS-friendly.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci --browsers=ChromeHeadless",
    "lint": "ng lint",
